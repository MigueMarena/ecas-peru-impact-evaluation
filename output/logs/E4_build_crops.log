>  & !mi(ln_`v',med_1,mad_1)
 14.         replace zmod_2 =  0.6745*(       `v' - med_2)/mad_2     if mad_2>0
>  & !mi(`v',med_2,mad_2)
 15.         gen double ln_hi = med_1 + (3.5/0.6745)*mad_1   if !mi(med_1,mad_1
> )
 16.         gen double ln_lo = med_1 - (3.5/0.6745)*mad_1   if !mi(med_1,mad_1
> )
 17.         gen double hi    = med_2 + (3.5/0.6745)*mad_2   if !mi(med_2,mad_2
> )
 18.         gen double lo    = med_2 - (3.5/0.6745)*mad_2   if !mi(med_2,mad_2
> )
 19.         // Nota: 0.6745 normaliza el MAD para que sea comparable con la de
> svest bajo 
.         // normalidad (pero sin requerir que los datos sean normales)
. 
.         // 5. "Flaggear" outliers mayores/menores a criterio robusto (z-modif
> icado de 3.5)
.         gen flag_out1_35        = 0 if !mi(ln_`v') & `v'>0
 20.         gen flag_out2_35        = 0 if !mi(`v') & `v'>0
 21.         replace flag_out1_35 = 1 if abs(zmod_1)>3.5 & !mi(zmod_1)
 22.         replace flag_out2_35 = 1 if abs(zmod_2)>3.5 & !mi(zmod_2)
 23. 
.         // 6. Crear precios winsorizosados e imputando con missings a outlier
> s
.         // Winsorización 1 y 2:
.         // Capar en el umbral robusto (mediana ± (3.5/0.6745)*MAD) retransfor
> mado en niveles para wz1,
.         // y en niveles para wz2, si > 10 obs en el cultivo.
.         // Imputar mediana a outliers de var. en logs (1) y en niveles (2) si
>  <= 10 obs en el cultivo
.         gen double `v'_wz1 = .
 24.         gen double `v'_wz2 = .
 25.         gen double `v'_mis = .
 26. 
.         // Capar en el umbral robusto si hay más de 10 obs.
.         replace `v'_wz1 = exp(ln_lo)    if flag_out1_35==1 & zmod_1<0 & count
> er>10 & mad_1>0
 27.         replace `v'_wz2 = lo                    if flag_out2_35==1 & zmod_
> 2<0 & counter>10 & mad_2>0
 28.         replace `v'_wz1 = exp(ln_hi)    if flag_out1_35==1 & zmod_1>0 & co
> unter>10 & mad_1>0
 29.         replace `v'_wz2 = hi                    if flag_out2_35==1 & zmod_
> 2>0 & counter>10 & mad_2>0
 30. 
.         // Imputar mediana si hay 10 o menos obs
.         replace `v'_wz1 = med_2         if flag_out1_35==1 & counter<=10 
 31.         replace `v'_wz2 = med_2         if flag_out2_35==1 & counter<=10 
 32. 
.         // Reemplazar los demás casos con la variable original 
.         replace `v'_wz1 = `v' if mi(`v'_wz1)
 33.         replace `v'_wz2 = `v' if mi(`v'_wz2)
 34. 
.         // Imputar missing cuando se detecta como outlier con la var en logs 
> o niveles 
.         replace `v'_mis = `v' if flag_out1_35!=1 & flag_out2_35!=1
 35.         
.         // 7. Eliminar las variables que no usaremos
.         drop counter ln_* hi lo med_* mad_* zmod_* flag_*
 36.         
.         // 8. Ordenar las variables creadas
.         order `v'_wz1, a(`v')
 37.         order `v'_wz2, a(`v'_wz1)
 38.         order `v'_mis, a(`v'_wz2)
 39. }
