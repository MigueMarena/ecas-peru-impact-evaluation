  4. 
.         // 3. Calcular estadísticos robustos dentro de cada cultivo
.         ** 3.1. Mediana
.         by preg114b1: egen med_1 = median(ln_`v')       if !mi(ln_`v') & `v'>
> 0 
  5.         by preg114b1: egen med_2 = median(`v')          if !mi(`v')    & `
> v'>0 
  6. 
.         ** 3.2. MAD (Median Absolute Deviation)
.         gen double abs_dev_1 = abs(ln_`v' - med_1)      if !mi(ln_`v') & `v'>
> 0
  7.         gen double abs_dev_2 = abs(`v' - med_2)         if !mi(`v')    & `
> v'>0
  8.         by preg114b1: egen mad_1 = median(abs_dev_1) if !mi(ln_`v') & `v'>
> 0
  9.         by preg114b1: egen mad_2 = median(abs_dev_2) if !mi(`v')          
>  & `v'>0
 10.         drop abs_dev_*
 11. 
.         // 4. Generar los Z-SCORE modificados y límites sup. e inf. para cape
> ar
.         gen double zmod_1 = .
 12.         gen double zmod_2 = .
