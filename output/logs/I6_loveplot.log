. //==============================================================================
. // Step 3: Programa para calcular SMD cruda y ajustada por variable
. //==============================================================================
. cap program drop _smd_one

. program define _smd_one, rclass
  1.         args var
  2.         qui summ `var' if asig_ccpp == 0
  3.         local sd_C = r(sd)
  4.         qui summ `var' if asig_ccpp == 1
  5.         local sd_T = r(sd)
  6.         local sd_pool = sqrt((`sd_C'^2 + `sd_T'^2) / 2)
  7.         if `sd_pool' == 0 | mi(`sd_pool') {
  8.                 return scalar smd_c = .
  9.                 return scalar smd_a = .
 10.                 return scalar p_c   = .
 11.                 return scalar p_a   = .
 12.                 exit
 13.         }
 14.         tempvar _z
 15.         qui gen `_z' = `var' / `sd_pool'
 16.         qui reg `_z' asig_ccpp i.cod_rgn_PE, cluster(cod_cpb)
 17.         local smd_c = _b[asig_ccpp]
 18.         local p_c   = 2 * ttail(e(df_r), abs(_b[asig_ccpp] / _se[asig_ccpp]))
 19.         qui reg `_z' asig_ccpp i.cod_rgn_PE i.mes_enc, cluster(cod_cpb)
 20.         local smd_a = _b[asig_ccpp]
 21.         local p_a   = 2 * ttail(e(df_r), abs(_b[asig_ccpp] / _se[asig_ccpp]))
 22.         return scalar smd_c = `smd_c'
 23.         return scalar smd_a = `smd_a'
 24.         return scalar p_c   = `p_c'
 25.         return scalar p_a   = `p_a'
 26. end

. 
