. //---------------------------------------------------------------------------
> ---
. // File           : G6Ab_estimate_subind_ena_vF_vE.do
. // Author         : Carlos Marena
. // Email          : carlosmarena1995@gmail.com
. // Last Mod. Date : 21/05/2026
. // Description    : Genera tablas anexas con estimaciones ITT en formato de 2
. //                  paneles (Estimaciones / Descriptivos) para los 7 sub-
. //                  indicadores ENA de BPAs en sus versiones de robustez:
. //                    - vF (Flexible: >=N de M sub-prácticas)
. //                    - vE (Estricta: AND de todas las sub-prácticas)
. //                  Estas tablas complementan a G6Aa (versión vO en la secció
> n
. //                  principal) como anexos de robustez.
. //                  Flujo: (1) carga vía prg_load_panel; (2) construye D_c y
. //                  P_i de forma explícita; (3) declara los labels amigables
. //                  del paper una sola vez con `lab var` (single source of
. //                  truth — sobreescribe los labels técnicos de E10); (4)
. //                  itera con `foreach ver` × `forvalues k` invocando
. //                  prg_table_2panels.
. //
. // Output         : Anexos/Indicadores_Compuestos_BPAs/A-5-<k>_Tab_SubInd_<st
> ub>_vF.docx (×7)
. //                  Anexos/Indicadores_Compuestos_BPAs/A-6-<k>_Tab_SubInd_<st
> ub>_vE.docx (×7)
. // Depends        : _helpers/prg_load_panel.do
. //                  _helpers/prg_table_3panels.do   (carga los helpers _fmt_*
> )
. //                  _helpers/prg_table_2panels.do
. //                  _helpers/fix_table_borders.ps1  (invocado por el programa
> )
. //---------------------------------------------------------------------------
> ---
. 
. cls

. 
. // Bootstrap del entorno (define globals: ruta_data, ruta_anexos, ruta_helper
> s, ...)
. if "${CONSULT}" == "" qui do "C:\\Users\\carlo\\ado\\personal\\profile.do"

. qui include "${CONSULT}\\BID\\HRC0052956\\2_Scripts\\A_master.do"

. 
. // Cargar los programas (ruta_helpers es GLOBAL definido por A_master.do)
. qui do "${ruta_helpers}/prg_load_panel.do"

. qui do "${ruta_helpers}/prg_table_3panels.do"  // helpers _fmt_b, _fmt_se, _f
> mt_N, _fmt_F

. qui do "${ruta_helpers}/prg_table_2panels.do"

. 
. //---------------------------------------------------------------------------
> ---
. // 1. Cargar la base maestra + outcomes vF y vE + vars crudas para D_c/P_i
. //---------------------------------------------------------------------------
> ---
. prg_load_panel, ///
>         outcome_file("BPAs_Compuestos_LByLS") ///
>         outcome_vars(bpa_ena_*_vF bpa_ena_*_vE) ///
>         extra_vars(i1aECA_PE_ccpp ptcp_ECA_prod)
